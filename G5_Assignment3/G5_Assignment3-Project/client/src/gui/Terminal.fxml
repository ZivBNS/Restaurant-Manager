<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="terminalRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="1000.0" prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Terminal_GUI" stylesheets="@/Theme/application_modern.css">
   <top>
      <VBox alignment="CENTER" BorderPane.alignment="CENTER">
         <padding><Insets bottom="10.0" top="20.0" /></padding>
         <children>
            <Label text="Terminal" textFill="#ecf0f1"><font><Font name="Segoe UI Light" size="48.0" /></font></Label>
            <Separator maxWidth="200.0" />
         </children>
      </VBox>
   </top>
   <center>
      <StackPane fx:id="mainStack" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane fx:id="welcomeView">
               <children>
                  <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Label text="Welcome" textFill="#ecf0f1"><font><Font name="Segoe UI Bold" size="32.0" /></font></Label>
                        <VBox alignment="CENTER" maxWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">
                           <effect><DropShadow color="#00000059" radius="15" /></effect>
                           <children>
                              <Label text="Subscriber Login" textFill="#34495e"><font><Font name="Segoe UI Bold" size="24.0" /></font></Label>
                              <TextField fx:id="welcomeUserField" promptText="Username" />
                              <PasswordField fx:id="welcomePassField" promptText="Password" />
                              <Button fx:id="btnWelcomeLogin" maxWidth="Infinity" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Login" />
                              <Label fx:id="welcomeErrorLabel" textFill="#e74c3c" visible="false"><font><Font size="10.0" /></font></Label>
                           </children>
                        </VBox>
                        <Button fx:id="btnContinueAsGuest" style="-fx-background-color: transparent; -fx-text-fill: #85c1e9; -fx-underline: true; -fx-cursor: hand;" text="Continue as Guest (No Subscription)"><font><Font size="16.0" /></font></Button>
                        <Label fx:id="lblScanBarcode" text="Scan Barcode" textFill="#95a5a6" style="-fx-cursor: hand; -fx-underline: true;">
                             <font><Font size="14.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
            
            <VBox fx:id="terminalView" alignment="TOP_CENTER" spacing="20.0" visible="false">
               <padding><Insets top="20.0" /></padding>
               <children>
                  <Label fx:id="lblUserGreeting" text="Please choose an action" textFill="#ecf0f1"><font><Font name="Segoe UI Semibold" size="24.0" /></font></Label>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="I have reservation" textFill="#bdc3c7"><font><Font name="Segoe UI Bold" size="12.0" /></font></Label>
                              <Button fx:id="btnCheckIn" minHeight="100.0" minWidth="160.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Check IN" textFill="#27ae60" wrapText="true"><font><Font name="Segoe UI Bold" size="18.0" /></font><effect><DropShadow color="#00000033" radius="5" /></effect></Button>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="Don't have reservation?" textFill="#bdc3c7"><font><Font name="Segoe UI Bold" size="12.0" /></font></Label>
                              <Button fx:id="btnInstantBooking" minHeight="100.0" minWidth="160.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Instant Booking" textFill="#e67e22" wrapText="true"><font><Font name="Segoe UI Bold" size="18.0" /></font><effect><DropShadow color="#00000033" radius="5" /></effect></Button>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="Bill payment" textFill="#bdc3c7"><font><Font name="Segoe UI Bold" size="12.0" /></font></Label>
                              <Button fx:id="btnPayBill" minHeight="100.0" minWidth="160.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Pay Bill" textFill="#2980b9" wrapText="true"><font><Font name="Segoe UI Bold" size="18.0" /></font><effect><DropShadow color="#00000033" radius="5" /></effect></Button>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="I regreted" textFill="#bdc3c7"><font><Font name="Segoe UI Bold" size="12.0" /></font></Label>
                              <Button fx:id="btnCancelRes" minHeight="100.0" minWidth="160.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;" text="Cancel Reservation or Waitlist" textAlignment="CENTER" textFill="#c0392b" wrapText="true"><font><Font name="Segoe UI Bold" size="16.0" /></font><effect><DropShadow color="#00000033" radius="5" /></effect></Button>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <StackPane fx:id="actionFormsContainer" maxWidth="700.0" minHeight="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                     <effect><DropShadow color="#00000059" radius="15" /></effect>
                     <children>
                        <VBox fx:id="checkInForm" alignment="CENTER" spacing="15.0" visible="false">
                           <children>
                              <Label text="Enter Confirmation Code for Check-In" textFill="#2c3e50"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                              <TableView fx:id="todayReservationsTable" maxWidth="550.0" prefHeight="150.0" visible="false" managed="false" style="-fx-background-color: transparent; -fx-base: white; -fx-control-inner-background: white; -fx-table-cell-border-color: transparent; -fx-table-header-border-color: transparent; -fx-padding: 0; -fx-background-insets: 0;">
                                <columns>
                                  <TableColumn fx:id="colCode" text="Code" />
                                  <TableColumn fx:id="colDiners" text="Diners" />
                                  <TableColumn fx:id="colStart" text="Start" />
                                  <TableColumn fx:id="colEnd" text="End" />
                                </columns>
                                <columnResizePolicy>
                                   <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                              </TableView>
                              <TextField fx:id="checkInCodeField" maxWidth="250.0" promptText="e.g. 12345" />
                              <Button fx:id="btnSubmitCheckIn" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="Complete Check-In" />
                              <Label fx:id="checkInStatusLabel" textAlignment="CENTER" wrapText="true" />
                           </children>
                        </VBox>

                        <VBox fx:id="instantForm" alignment="CENTER" spacing="10.0" visible="false">
                           <children>
                              <Label text="Instant Booking Details" textFill="#2c3e50"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                              <Label fx:id="lblInstantBookingSubInfo" text="Please provide at least one: Phone or Email" textFill="#7f8c8d"><font><Font name="Segoe UI Italic" size="12.0" /></font></Label>
                              <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
                                 <children>
                                    <Label text="Diners:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Spinner fx:id="instDinersSpinner" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label fx:id="lblInstPhone" text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="instPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label fx:id="lblInstEmail" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <TextField fx:id="instEmailField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                 </children>
                              </GridPane>
                              <Button fx:id="btnSubmitInstant" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-cursor: hand;" text="Book Now" />
                              <Label fx:id="instStatusLabel" textAlignment="CENTER" wrapText="true" />
                              
                              <VBox fx:id="waitlistProposalBox" alignment="CENTER" visible="false" managed="false" spacing="15.0" style="-fx-background-color: #fff3cd; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #ffeeba; -fx-border-width: 2;">
                                 <children>
                                    <Label text="No tables available at the moment.&#10;Would you like to join the Waitlist?" textAlignment="CENTER" textFill="#856404" wrapText="true">
                                       <font>
                                          <Font name="System Bold" size="15.0" />
                                       </font>
                                    </Label>
                                    <HBox alignment="CENTER" spacing="15.0">
                                       <children>
                                          <Button fx:id="btnJoinWaitlist" mnemonicParsing="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 20;" text="Join Waitlist" />
                                          <Button fx:id="btnReturnWaitlist" mnemonicParsing="false" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20;" text="Return" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                              
                           </children>
                        </VBox>

                        <VBox fx:id="payBillForm" alignment="CENTER" spacing="15.0" visible="false">
                           <children>
                              <Label text="Enter Code to View Bill" textFill="#2c3e50"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                              <TextField fx:id="payBillCodeField" maxWidth="250.0" promptText="e.g. 12345" />
                              
                              <Button fx:id="btnFetchBill" style="-fx-cursor: hand;" text="View Bill" />
                              <Label fx:id="payBillStatusLabel" textAlignment="CENTER" wrapText="true" />
                              
                              <VBox fx:id="billDetailsBox" alignment="CENTER" spacing="5.0" visible="false">
                                 <children>
                                    <Button fx:id="btnGoToPayment" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;" text="Pay with Credit Card" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <VBox fx:id="cancelForm" alignment="CENTER" spacing="15.0" visible="false">
                           <children>
                              <Label text="Enter Code to Cancel" textFill="#2c3e50"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                              <TextField fx:id="cancelCodeField" maxWidth="250.0" promptText="e.g. 12345" />
                              <Button fx:id="btnSubmitCancel" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;" text="Confirm Cancellation" />
                              <Label fx:id="cancelStatusLabel" textAlignment="CENTER" wrapText="true" />
                           </children>
                        </VBox>

						<VBox fx:id="forgotCodeView" alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: white;" visible="false">
						   <children>
						      <HBox alignment="TOP_RIGHT">
						         <children>
						            <Button fx:id="btnCloseForgot" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="X" />
						         </children>
						      </HBox>
						      <Label text="Retrieve My Codes" textFill="#2c3e50"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
						      <VBox alignment="CENTER" spacing="10.0">
						         <children>
						            <TextField fx:id="forgotPhoneField" maxWidth="200.0" promptText="Enter Phone" />
						            <TextField fx:id="forgotEmailField" maxWidth="200.0" promptText="Enter Email" />
						            <Button fx:id="btnSubmitForgot" style="-fx-cursor: hand;" text="Find Reservations" />
						            
						            <Label fx:id="forgotStatusLabel" visible="false" wrapText="true" textAlignment="CENTER" maxWidth="250.0"/>
						            
						         </children>
						      </VBox>
						   </children>
						</VBox>
                     </children>
                  </StackPane>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
         <children>
            <Button fx:id="backBtn" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-underline: true; -fx-cursor: hand;" text="Return to Home Screen" />
            <Region HBox.hgrow="ALWAYS" />
            <Hyperlink fx:id="hlForgotCode" text="FORGOT THE CODE?" textFill="#5dade2" />
         </children>
      </HBox>
   </bottom>
</BorderPane>