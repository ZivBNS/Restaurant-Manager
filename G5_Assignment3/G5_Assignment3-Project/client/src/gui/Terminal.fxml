<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="terminalRoot" maxHeight="-Infinity"
	maxWidth="-Infinity" minHeight="600.0" minWidth="900.0"
	style="-fx-background-color: #ecf0f1;"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="gui.Terminal_GUI">

	<top>
		<VBox alignment="CENTER">
			<padding>
				<Insets bottom="20.0" top="30.0" />
			</padding>
			<Label text="Terminal" textFill="#2c3e50">
				<font>
					<Font name="Segoe UI Light" size="58.0" />
				</font>
			</Label>
			<Separator maxWidth="200.0" />
		</VBox>
	</top>

	<center>
		<TilePane alignment="CENTER" hgap="30.0" vgap="30.0"
			prefColumns="3" prefTileHeight="220.0" prefTileWidth="260.0"
			BorderPane.alignment="CENTER">
			<padding>
				<Insets bottom="40.0" left="40.0" right="40.0" top="10.0" />
			</padding>

			<Button fx:id="btnJoinWaitlist"
				maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
				mnemonicParsing="false"
				style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;"
				text="Check IN (Join Waitlist)" textFill="#27ae60">
				<font>
					<Font name="Segoe UI" size="20.0" />
				</font>
				<effect>
					<DropShadow color="#0000001a" height="10.0" radius="4.5"
						width="10.0" />
				</effect>
			</Button>

			<VBox alignment="CENTER" maxHeight="1.7976931348623157E308"
				maxWidth="1.7976931348623157E308"
				style="-fx-background-color: white; -fx-background-radius: 10;">
				<effect>
					<DropShadow color="#0000001a" height="10.0" radius="4.5"
						width="10.0" />
				</effect>
				<children>
					<Label text="[ Scan Code ]" textFill="#7f8c8d">
						<font>
							<Font name="Segoe UI Bold" size="18.0" />
						</font>
					</Label>
					<Label text="Simulate Tag Reader" textFill="#bdc3c7">
						<font>
							<Font size="12.0" />
						</font>
					</Label>
				</children>
			</VBox>

			<Button fx:id="btnPayBill" maxHeight="1.7976931348623157E308"
				maxWidth="1.7976931348623157E308" mnemonicParsing="false"
				style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;"
				text="Pay Bill" textFill="#2980b9">
				<font>
					<Font name="Segoe UI" size="20.0" />
				</font>
				<effect>
					<DropShadow color="#0000001a" height="10.0" radius="4.5"
						width="10.0" />
				</effect>
			</Button>

			<Button fx:id="btnLeaveWaitlist"
				maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
				mnemonicParsing="false"
				style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;"
				text="Leave Waitlist" textFill="#e67e22">
				<font>
					<Font name="Segoe UI" size="20.0" />
				</font>
				<effect>
					<DropShadow color="#0000001a" height="10.0" radius="4.5"
						width="10.0" />
				</effect>
			</Button>

			<VBox alignment="CENTER" maxHeight="1.7976931348623157E308"
				maxWidth="1.7976931348623157E308" spacing="10.0"
				style="-fx-background-color: white; -fx-background-radius: 10;">
				<effect>
					<DropShadow color="#0000001a" height="10.0" radius="4.5"
						width="10.0" />
				</effect>
				<padding>
					<Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
				</padding>
				<children>
					<Label text="Subscriber Login" textFill="#2c3e50">
						<font>
							<Font name="Segoe UI Bold" size="16.0" />
						</font>
					</Label>
					<TextField fx:id="termUserField" promptText="Username"
						style="-fx-background-radius: 5;" />
					<PasswordField fx:id="termPassField"
						promptText="Password" style="-fx-background-radius: 5;" />
					<Button fx:id="termLoginBtn"
						maxWidth="1.7976931348623157E308" mnemonicParsing="false"
						style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
						text="Login">
						<font>
							<Font name="Segoe UI Bold" size="12.0" />
						</font>
					</Button>
					<Label fx:id="termErrorLabel" text="Error Message"
						textFill="#e74c3c" visible="false">
						<font>
							<Font size="10.0" />
						</font>
					</Label>
				</children>
			</VBox>

			<Button fx:id="btnCancelRes"
				maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
				mnemonicParsing="false"
				style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand;"
				text="Cancel Reservation" textFill="#c0392b">
				<font>
					<Font name="Segoe UI" size="20.0" />
				</font>
				<effect>
					<DropShadow color="#0000001a" height="10.0" radius="4.5"
						width="10.0" />
				</effect>
			</Button>

		</TilePane>
	</center>

	<bottom>
		<HBox alignment="CENTER_LEFT">
			<padding>
				<Insets bottom="20" left="20" right="20" top="20" />
			</padding>
			<Button fx:id="backBtn"
				style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-underline: true; -fx-cursor: hand;"
				text="&lt; Back to Main" />
		</HBox>
	</bottom>

</BorderPane>