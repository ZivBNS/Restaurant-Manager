<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.CasualCustomer_GUI"
            prefWidth="400" prefHeight="500"
            style="-fx-background-color: #f7f7f7;">

    <children>

        <!-- Centered Page Title -->
        <Label text="Casual Customer"
               AnchorPane.topAnchor="20"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               alignment="CENTER"
               style="-fx-font-size: 26px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2c3e50;" />

        <!-- Card Container -->
        <VBox spacing="18"
              AnchorPane.topAnchor="70"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40"
              style="
                  -fx-background-color: white;
                  -fx-background-radius: 16;
                  -fx-padding: 30;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);
              ">

            <!-- Menu Header (Guest Login style) -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="Menu"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: 600;
                              -fx-text-fill: #2c3e50;" />
                <Separator prefWidth="200" opacity="0.6"/>
            </VBox>

            <!-- Menu Buttons -->
            <Button text="New Order"  prefWidth="280" onAction="#openNewOrder"/>
            <Button text="View Order" prefWidth="280"/>
            <Button text="Cancel Order" prefWidth="280"/>
            <Button text="Edit Order" prefWidth="280"/>
            <Button text="Bill Payment" prefWidth="280" onAction="#onBillPaymentClicked"/>

            <!-- Back Button -->
            <Button text="Back"
                    prefWidth="80"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;"
                    onAction="#onBackClicked"/>

        </VBox>

    </children>
</AnchorPane>


