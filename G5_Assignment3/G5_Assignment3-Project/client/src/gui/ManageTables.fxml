<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="manageTablesRoot" prefHeight="900.0" prefWidth="1250.0" stylesheets="/Theme/application.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ManageTables_GUI">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets bottom="20" top="20" /></padding>
            <children>
                <Label styleClass="header-title" text="Manage Tables" />
                <Label styleClass="card-label" text="Add, remove or update restaurant tables layout" />
                <Separator maxWidth="400" opacity="0.35" />
            </children>
        </VBox>
    </top>

    <center>
        <HBox spacing="25">
            <padding><Insets bottom="20" left="25" right="25" top="10" /></padding>
            <children>
                
                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                    <children>
                        <Label styleClass="card-title" text="Restaurant Layout" />
                        <TableView fx:id="tablesTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTableNumber" prefWidth="100.0" text="Table #" />
                                <TableColumn fx:id="colTableSize" prefWidth="100.0" text="Capacity" />
                                <TableColumn fx:id="colActive" prefWidth="100.0" text="Active" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox prefWidth="350.0" spacing="15.0" styleClass="card">
                    <padding><Insets bottom="25" left="25" right="25" top="25" /></padding>
                    <children>
                        <Label styleClass="card-title" text="Table Details" />
                        <Separator opacity="0.1" />

                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="card-label" text="Table Number" />
                                <TextField fx:id="tableNumberField" promptText="e.g. 15" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="card-label" text="Seating Capacity" />
                                <TextField fx:id="tableSizeField" promptText="e.g. 4" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="card-label" text="Status" />
                                <CheckBox fx:id="activeCheckBox" text="Table is Active" textFill="WHITE" style="-fx-cursor: hand;"/>
                            </children>
                        </VBox>

                        <Separator opacity="0.1">
                            <VBox.margin><Insets top="15.0" /></VBox.margin>
                        </Separator>

                        <VBox spacing="12.0">
                            <HBox spacing="10.0">
                                <Button maxWidth="Infinity" onAction="#onSaveNewClicked" styleClass="button, btn-primary" text="Add New" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="Infinity" onAction="#onUpdateClicked" styleClass="button, btn-secondary" text="Update" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <Button maxWidth="Infinity" onAction="#onClearClicked" styleClass="button" text="Clear Selection" />
                            <Button maxWidth="Infinity" onAction="#onDeleteClicked" styleClass="button, btn-danger" text="Delete Table" />
                        </VBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding><Insets bottom="30" left="30" /></padding>
            <children>
                <Button onAction="#onBackClicked" styleClass="button, btn-secondary" text="Back to Menu" />
            </children>
        </HBox>
    </bottom>

</BorderPane>