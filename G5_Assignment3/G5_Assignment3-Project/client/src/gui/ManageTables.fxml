<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="manageTablesRoot" prefHeight="600.0" prefWidth="600.0" stylesheets="/Theme/application.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ManageTables_GUI">

	<top>
		<VBox alignment="CENTER" spacing="10">
			<padding>
				<Insets bottom="20" top="20" />
			</padding>
			<children>
				<Label styleClass="header-title" text="Manage Tables" />
				<Separator maxWidth="300" />
			</children>
		</VBox>
	</top>

	<center>
		<VBox spacing="15">
			<padding>
				<Insets bottom="15" left="30" right="30" />
			</padding>
			<children>
				<VBox styleClass="card" VBox.vgrow="ALWAYS">
					<padding>
						<Insets bottom="10" left="10" right="10" top="10" />
					</padding>
					<children>
						<TableView fx:id="tablesTable" VBox.vgrow="ALWAYS">
							<columns>
								<TableColumn fx:id="colTableNumber" prefWidth="120" text="Table #" />
								<TableColumn fx:id="colTableSize" prefWidth="120" text="Size" />
								<TableColumn fx:id="colActive" prefWidth="120" text="Active" />
							</columns>
							<columnResizePolicy>
								<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
							</columnResizePolicy>
						</TableView>
					</children>
				</VBox>
			</children>
		</VBox>
	</center>

	<bottom>
		<VBox>
			<padding>
				<Insets bottom="20" left="20" right="20" />
			</padding>
			<children>
				<VBox spacing="20" styleClass="card">
					<padding>
						<Insets bottom="20" left="15" right="15" top="20" />
					</padding>
		
					<children>
						<HBox alignment="CENTER" spacing="20">
							<children>
								<VBox spacing="5">
									<children>
										<Label styleClass="card-label" text="Table Number" />
										<TextField fx:id="tableNumberField" prefWidth="120" />
									</children>
								</VBox>
								
								<VBox spacing="5">
									<children>
										<Label styleClass="card-label" text="Table Size" />
										<TextField fx:id="tableSizeField" prefWidth="120" />
									</children>
								</VBox>
								
								<VBox spacing="5">
									<children>
										<Label styleClass="card-label" text="Active" />
										<CheckBox fx:id="activeCheckBox" />
									</children>
								</VBox>
							</children>
						</HBox>
			
						<HBox alignment="CENTER" spacing="8">
							<children>
								<Button onAction="#onBackClicked" styleClass="button, btn-secondary" text="Back" />
								<Button onAction="#onUpdateClicked" styleClass="button, btn-primary" text="Update Table" />
								<Button onAction="#onSaveNewClicked" styleClass="button, btn-primary" text="Save New Table" />
								<Button onAction="#onDeleteClicked" styleClass="button, btn-danger" text="Delete Table" />
							</children>
						</HBox>
					</children>
				</VBox>
			</children>
		</VBox>
	</bottom>
</BorderPane>