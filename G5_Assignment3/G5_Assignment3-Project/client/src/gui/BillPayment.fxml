<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="450.0" stylesheets="/Theme/application.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BillPayment_GUI">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="20" top="40" />
            </padding>
            <children>
                <Label styleClass="header-title" text="Bistro Service" />
                <Label styleClass="card-label" text="Bill Payment" />
                <Separator maxWidth="250" opacity="0.35" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
            </padding>
            <children>
                <VBox maxWidth="350" spacing="20" styleClass="card">
                    <padding>
                        <Insets bottom="30" left="30" right="30" top="30" />
                    </padding>
                    <children>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label styleClass="card-label" text="Reservation ID:" />
                                <Label fx:id="lblReservationId" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                            </children>
                        </HBox>

                        <VBox spacing="4">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label styleClass="card-label" text="Amount to Pay:" />
                                        <VBox spacing="2">
                                            <children>
                                                <Label fx:id="lblOriginalAmount" managed="false" visible="false" style="-fx-text-fill: #999999; -fx-font-size: 13px; -fx-strikethrough: true;" />
                                                <Label fx:id="lblDiscountInfo" managed="false" visible="false" style="-fx-text-fill: #2ecc71; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                                <Label fx:id="lblTotalAmount" style="-fx-text-fill: #d4a358; -fx-font-size: 20px; -fx-font-weight: bold;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <Label styleClass="card-label" text="Bill Details" />
                                <Label fx:id="lblBillDetails" maxWidth="280" style="-fx-text-fill: white;" wrapText="true" />
                            </children>
                        </VBox>

                        <Separator opacity="0.3">
                            <VBox.margin>
                                <Insets bottom="5" top="5" />
                            </VBox.margin>
                        </Separator>

                        <VBox spacing="10">
                            <children>
                                <Button fx:id="btnPay" maxWidth="Infinity" onAction="#onPay" prefHeight="45" styleClass="button, btn-primary" text="Pay" />
                                <Button maxWidth="Infinity" onAction="#onBackClicked" prefHeight="45" styleClass="button, btn-secondary" text="Back" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="15" top="10" />
            </padding>
            <children>
                <Label style="-fx-font-size: 10px; -fx-text-fill: #7f85a3;" text="Bistro Management System v1.0" />
            </children>
        </VBox>
    </bottom>

</BorderPane>








