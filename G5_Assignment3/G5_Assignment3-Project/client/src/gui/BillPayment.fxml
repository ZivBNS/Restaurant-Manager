<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BillPayment_GUI" stylesheets="@/Theme/application_modern.css">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="20" top="40" />
            </padding>
            <children>
                <Label styleClass="header-title" text="Bistro Service" />
                <Label styleClass="card-label" text="Bill Payment" />
                <Separator maxWidth="250" opacity="0.35" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
            </padding>
            <children>
                <VBox maxWidth="400" spacing="20" styleClass="card" style="-fx-background-color: #1e1e26; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 5);">
                    <padding>
                        <Insets bottom="30" left="30" right="30" top="30" />
                    </padding>
                    <children>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label styleClass="card-label" text="Reservation ID:" />
                                <Label fx:id="lblReservationId" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" />
                            </children>
                        </HBox>

                        <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: rgba(212, 163, 88, 0.2); -fx-border-radius: 10;">
                            <children>
                                <Label styleClass="card-label" style="-fx-font-size: 12px; -fx-opacity: 0.7;" text="Payment Summary" />
                                
                                <Label fx:id="lblOriginalAmount" managed="false" style="-fx-text-fill: #999999; -fx-font-size: 14px; -fx-strikethrough: true;" visible="false" />
                                
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="lblDiscountInfo" managed="false" style="-fx-text-fill: #2ecc71; -fx-font-size: 15px; -fx-font-weight: bold;" visible="false" wrapText="false" />
                                    </children>
                                </HBox>
                                
                                <Separator opacity="0.1" />
                                
                                <HBox alignment="BASELINE_LEFT" spacing="10">
                                    <children>
                                        <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Total to Pay:" />
                                        <Label fx:id="lblTotalAmount" style="-fx-text-fill: #d4a358; -fx-font-size: 26px; -fx-font-weight: bold;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="8">
                            <children>
                                <Label styleClass="card-label" text="Bill Details" />
                                <Label fx:id="lblBillDetails" maxWidth="340" minHeight="-Infinity" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-line-spacing: 3;" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="12">
                            <padding><Insets top="10" /></padding>
                            <children>
                                <Button fx:id="btnPay" maxWidth="Infinity" onAction="#onPay" prefHeight="50" styleClass="button, btn-primary" text="Confirm &amp; Pay" />
                                <Button maxWidth="Infinity" onAction="#onBackClicked" prefHeight="45" styleClass="button, btn-secondary" text="Back" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>






