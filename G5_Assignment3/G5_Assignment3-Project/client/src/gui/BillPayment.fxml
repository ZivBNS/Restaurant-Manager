<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="600.0" prefWidth="450.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.BillPayment_GUI"
            style="-fx-background-color: #1e1e2f;">

    <children>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="6"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              AnchorPane.topAnchor="35">

            <Label text="Bistro Service"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

            <Label text="Bill Payment"
                   style="-fx-font-size: 14px; -fx-text-fill: #b0b3c6;"/>
        </VBox>

        <!-- Main Card -->
        <VBox spacing="22" alignment="CENTER"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40"
              AnchorPane.topAnchor="150"
              style="-fx-background-color: #26283b; -fx-background-radius: 22; -fx-padding: 40;">

            <effect>
                <DropShadow color="rgba(0,0,0,0.45)"
                            radius="25"
                            offsetX="0"
                            offsetY="8"/>
            </effect>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Reservation ID:" style="-fx-text-fill: #b0b3c6;"/>
                <Label fx:id="lblReservationId" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Amount to Pay:" style="-fx-text-fill: #b0b3c6;"/>
                <Label fx:id="lblTotalAmount" style="-fx-text-fill: #2ecc71; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Bill Details" style="-fx-text-fill: #b0b3c6;"/>
                <Label fx:id="lblBillDetails"
                       wrapText="true"
                       maxWidth="280"
                       style="-fx-text-fill: #ffffff;"/>
            </VBox>

            <Separator prefWidth="220" opacity="0.3">
                <padding>
                    <Insets top="12" bottom="12"/>
                </padding>
            </Separator>

            <Button fx:id="btnPay"
                    text="Pay"
                    onAction="#onPay"
                    prefHeight="50"
                    prefWidth="260"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: #1e1e2f; -fx-font-size: 14px; -fx-background-radius: 14; -fx-cursor: hand;"/>

            <Button text="Back"
                    onAction="#onBackClicked"
                    prefWidth="260"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>

        <!-- Footer -->
        <Label text="Bistro Management System v1.0"
               AnchorPane.bottomAnchor="20"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               alignment="CENTER"
               style="-fx-font-size: 10px; -fx-text-fill: #7f85a3;"/>

    </children>
</AnchorPane>









