<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefWidth="450" prefHeight="600"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.BillPayment_GUI"
            style="-fx-background-color: linear-gradient(to bottom right, #1f2c3c, #243447);">

    <children>

        <VBox alignment="CENTER" spacing="20"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40"
              AnchorPane.topAnchor="60">

            <Label text="Bill Payment"
                   style="-fx-font-size:28; -fx-text-fill:white; -fx-font-weight:bold;" />

            <VBox spacing="12" style="-fx-background-color:#2c3e50; -fx-padding:20; -fx-background-radius:15;">

                <Label text="Reservation Details"
                       style="-fx-font-size:16; -fx-text-fill:white;" />

                <HBox spacing="10">
                    <Label text="Date:" style="-fx-text-fill:#7f85a3;"/>
                    <Label fx:id="lblDate" style="-fx-text-fill:white;"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Time:" style="-fx-text-fill:#7f85a3;"/>
                    <Label fx:id="lblTime" style="-fx-text-fill:white;"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Guests:" style="-fx-text-fill:#7f85a3;"/>
                    <Label fx:id="lblGuests" style="-fx-text-fill:white;"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Table:" style="-fx-text-fill:#7f85a3;"/>
                    <Label fx:id="lblTable" style="-fx-text-fill:white;"/>
                </HBox>

            </VBox>

            <TextField fx:id="paymentField"
                       promptText="Enter payment amount"
                       style="-fx-background-radius:10; -fx-padding:12;"/>

            <Button text="Pay"
                    onAction="#onPay"
                    style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-font-weight:bold; -fx-padding:12 40; -fx-background-radius:15;"/>

            <Button text="Back"
                    onAction="#onBackClicked"
                    style="-fx-background-color:#34495e; -fx-text-fill:white; -fx-padding:10 35; -fx-background-radius:15;"/>

        </VBox>
    </children>
</AnchorPane>




