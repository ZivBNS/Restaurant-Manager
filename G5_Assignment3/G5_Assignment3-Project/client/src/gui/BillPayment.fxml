<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.BillPayment_GUI"
            prefWidth="350" prefHeight="500">

    <children>

        <!-- Title -->
        <Label text="Bill Payment"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               AnchorPane.topAnchor="40"
               AnchorPane.leftAnchor="90"/>

        <!-- Payment Amount Input -->
        <TextField fx:id="paymentField"
                   promptText="Amount"
                   prefWidth="250"
                   AnchorPane.topAnchor="120"
                   AnchorPane.leftAnchor="50"/>

        <!-- Pay Button -->
        <Button text="Pay"
                prefWidth="250"
                onAction="#onPay"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                AnchorPane.topAnchor="180"
                AnchorPane.leftAnchor="50"/>

        <!-- Back Button -->
        <Button text="Back"
                prefWidth="250"
                onAction="#onBackClicked"
                AnchorPane.topAnchor="230"
                AnchorPane.leftAnchor="50"/>

    </children>

</AnchorPane>





