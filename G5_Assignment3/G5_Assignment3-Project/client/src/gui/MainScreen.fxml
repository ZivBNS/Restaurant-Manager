<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainRoot"
            prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.MainScreen_GUI"
            style="-fx-background-color: #1e1e2f;">

    <top>
        <VBox alignment="CENTER" spacing="6">
            <padding>
                <Insets top="30" bottom="20"/>
            </padding>

            <Label text="Bistro Service"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Welcome to Bistro Management System"
                   style="-fx-font-size: 14px; -fx-text-fill: #b0b3c6;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="40" alignment="CENTER">
            <padding>
                <Insets top="40"/>
            </padding>

            <VBox spacing="14" alignment="CENTER"
                  style="-fx-background-color: #26283b; -fx-background-radius: 22; -fx-padding: 28;"
                  prefWidth="300">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.45)" radius="25" offsetY="8"/>
                </effect>

                <Label text="Guest Login"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Separator opacity="0.3"/>

                <HBox spacing="15">
                    <RadioButton fx:id="radioPhone" text="Phone" selected="true"
                                 toggleGroup="$guestIdentGroup"
                                 style="-fx-text-fill: #b0b3c6;"/>
                    <RadioButton fx:id="radioEmail" text="Email"
                                 toggleGroup="$guestIdentGroup"
                                 style="-fx-text-fill: #b0b3c6;"/>
                </HBox>

                <TextField fx:id="guestContactField"
                           promptText="Enter phone or email"
                           style="-fx-background-radius: 10; -fx-background-color: #2f324a; -fx-text-fill: white;"/>

                <Label fx:id="casualErrorLabel" textFill="#e74c3c" visible="false"/>

                <Button fx:id="guestLoginBtn"
                        text="Continue"
                        onAction="#onGuestLoginClick"
                        prefWidth="220"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: #1e1e2f; -fx-font-weight: bold; -fx-background-radius: 12;"/>
            </VBox>

            <VBox spacing="14" alignment="CENTER"
                  style="-fx-background-color: #26283b; -fx-background-radius: 22; -fx-padding: 28;"
                  prefWidth="300">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.45)" radius="25" offsetY="8"/>
                </effect>

                <Label text="Subscriber Login"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Separator opacity="0.3"/>

                <TextField fx:id="subUsernameField"
                           promptText="Username"
                           style="-fx-background-radius: 10; -fx-background-color: #2f324a; -fx-text-fill: white;"/>

                <PasswordField fx:id="subPasswordField"
                               promptText="Password"
                               style="-fx-background-radius: 10; -fx-background-color: #2f324a; -fx-text-fill: white;"/>

                <Label fx:id="subErrorLabel" textFill="#e74c3c" visible="false"/>

                <Button fx:id="subLoginBtn"
                        text="Login"
                        onAction="#onSubscriberLoginClick"
                        prefWidth="220"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12;"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets bottom="15" left="20" right="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="employeeToggleBtn"
                        text="Employee Login"
                        onAction="#onEmployeeToggleClick"
                        style="-fx-background-color: transparent; -fx-text-fill: #b0b3c6; -fx-underline: true;"/>

                <VBox fx:id="employeeLoginBox" spacing="5" visible="false">
                    <HBox spacing="5">
                        <TextField fx:id="empUserField" prefWidth="100" promptText="Username"/>
                        <PasswordField fx:id="empPassField" prefWidth="100" promptText="Password"/>
                        <Button fx:id="empSubmitBtn"
                                text="Go"
                                style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 11;"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="terminalBtn"
                        text="Open Terminal >"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #7f8c8d;
                               -fx-border-radius: 6;
                               -fx-text-fill: #7f8c8d;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>

