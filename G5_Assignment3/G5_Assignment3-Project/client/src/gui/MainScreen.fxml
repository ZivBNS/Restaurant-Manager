<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainRoot" maxHeight="-Infinity"
	maxWidth="-Infinity" minHeight="600.0" minWidth="900.0"
	nodeOrientation="LEFT_TO_RIGHT" style="-fx-background-color: #f4f4f4;"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="gui.MainScreen_GUI">

	<top>
		<VBox alignment="CENTER" spacing="10">
			<padding>
				<Insets bottom="30" left="30" right="30" top="30" />
			</padding>

			<Label text="Bistro" textFill="#2c3e50">
				<font>
					<Font name="Segoe UI Light" size="64.0" />
				</font>
			</Label>
		</VBox>
	</top>

	<center>
		<HBox alignment="CENTER" spacing="40.0"
			BorderPane.alignment="CENTER">
			<padding>
				<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
			</padding>

			<VBox alignment="TOP_CENTER" maxHeight="400.0" maxWidth="350.0"
				minHeight="350.0" minWidth="300.0" spacing="15.0"
				style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15;">
				<effect>
					<DropShadow color="#00000020" radius="10" spread="0.1" />
				</effect>
				<padding>
					<Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
				</padding>

				<Label text="Guest Login" textFill="#2c3e50">
					<font>
						<Font name="Segoe UI Bold" size="24.0" />
					</font>
				</Label>
				<Separator prefWidth="200.0" />

				<VBox spacing="15.0" VBox.vgrow="ALWAYS">
					<Label text="Identify via:" textFill="#34495e" />

					<HBox alignment="CENTER_LEFT" spacing="20.0">
						<RadioButton fx:id="radioPhone"
							mnemonicParsing="false" selected="true" text="Phone">
							<toggleGroup>
								<ToggleGroup fx:id="guestIdentGroup" />
							</toggleGroup>
						</RadioButton>
						<RadioButton fx:id="radioEmail"
							mnemonicParsing="false" text="Email"
							toggleGroup="$guestIdentGroup" />
					</HBox>

					<TextField fx:id="guestContactField"
						promptText="Enter Email/Phone Number..."
						style="-fx-background-radius: 5;" />
					<Label fx:id="casualErrorLabel"
						text="Error with Email or Phone" textFill="#e74c3c" visible="true">
						<font>
							<Font size="11.0" />
						</font>
					</Label>
				</VBox>

				<Button fx:id="guestLoginBtn"
					maxWidth="1.7976931348623157E308" mnemonicParsing="false"
					onAction="#openGuestMenu"
					style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
					text="Continue as Guest">
					<font>
						<Font name="Segoe UI Bold" size="14.0" />
					</font>
					<padding>
						<Insets bottom="10.0" top="10.0" />
					</padding>
				</Button>
			</VBox>

			<VBox alignment="TOP_CENTER" maxHeight="400.0" maxWidth="350.0"
				minHeight="350.0" minWidth="300.0" spacing="15.0"
				style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15;">
				<effect>
					<DropShadow color="#00000020" radius="10" spread="0.1" />
				</effect>
				<padding>
					<Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
				</padding>

				<Label text="Subscriber Login" textFill="#2c3e50">
					<font>
						<Font name="Segoe UI Bold" size="24.0" />
					</font>
				</Label>
				<Separator prefWidth="200.0" />

				<VBox spacing="10.0" VBox.vgrow="ALWAYS">
					<Label text="Username:" textFill="#34495e" />
					<TextField fx:id="subUsernameField"
						promptText="Enter Username..." style="-fx-background-radius: 5;" />

					<Label text="Password:" textFill="#34495e" />
					<PasswordField fx:id="subPasswordField"
						promptText="Enter Password..." style="-fx-background-radius: 5;" />

					<Label text="Invalid username or password" textFill="#e74c3c"
						visible="true">
						<font>
							<Font size="11.0" />
						</font>
					</Label>
				</VBox>

				<Button fx:id="subLoginBtn" maxWidth="1.7976931348623157E308"
					mnemonicParsing="false"
					style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
					onAction="#onSubscriberLoginClick" text="Login">
					<font>
						<Font name="Segoe UI Bold" size="14.0" />
					</font>
					<padding>
						<Insets bottom="10.0" top="10.0" />
					</padding>
				</Button>
			</VBox>
		</HBox>
	</center>

	<bottom>
		<VBox BorderPane.alignment="CENTER">
			<children>
				<Separator prefWidth="200.0" />

				<HBox alignment="CENTER" spacing="50.0">
					<padding>
						<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
					</padding>

					<HBox alignment="CENTER_LEFT" spacing="15.0"
						HBox.hgrow="ALWAYS">
						<Button fx:id="employeeToggleBtn" mnemonicParsing="false"
							onAction="#onEmployeeToggleClick"
							style="-fx-background-color: transparent; -fx-text-fill: #34495e; -fx-underline: true; -fx-cursor: hand;"
							text="Employee Login" />

						<VBox fx:id="employeeLoginBox" alignment="CENTER_LEFT"
							spacing="5.0" visible="false">
							<HBox spacing="5.0">
								<TextField fx:id="empUserField" prefWidth="120.0"
									promptText="Username" style="-fx-font-size: 11;" />
								<PasswordField fx:id="empPassField"
									prefWidth="120.0" promptText="Password"
									style="-fx-font-size: 11;" />
								<Button fx:id="empSubmitBtn"
									style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 11;"
									text="Go" />
							</HBox>
						</VBox>
					</HBox>

					<HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
						<Button fx:id="terminalBtn" mnemonicParsing="false"
							style="-fx-background-color: transparent; -fx-border-color: #7f8c8d; -fx-border-radius: 5; -fx-text-fill: #7f8c8d; -fx-cursor: hand;"
							text="Open Terminal >">
							<padding>
								<Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
							</padding>
						</Button>
					</HBox>
				</HBox>

				<HBox alignment="CENTER">
					<padding>
						<Insets bottom="5.0" />
					</padding>
					<Text fill="#bdc3c7" strokeType="OUTSIDE" strokeWidth="0.0"
						text="Bistro Management System v1.0 © 2025">
						<font>
							<Font size="10.0" />
						</font>
					</Text>
				</HBox>
			</children>
		</VBox>
	</bottom>
</BorderPane>