<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.CasualOrderForm_Controller"
            prefWidth="400" prefHeight="500">

    <children>

        <Label text="New Order:"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               AnchorPane.topAnchor="30"
               AnchorPane.leftAnchor="100"/>

        <TextField fx:id="guestsField"
                   promptText="Number of Guests"
                   prefWidth="250"
                   AnchorPane.topAnchor="90"
                   AnchorPane.leftAnchor="75"/>

        <DatePicker fx:id="datePicker"
                    prefWidth="250"
                    AnchorPane.topAnchor="150"
                    AnchorPane.leftAnchor="75"/>

        <ComboBox fx:id="timeCombo"
                  prefWidth="250"
                  promptText="Select Time"
                  AnchorPane.topAnchor="210"
                  AnchorPane.leftAnchor="75"/>

        <Button text="Submit Order"
                onAction="#onSubmitOrder"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                prefWidth="250"
                AnchorPane.topAnchor="280"
                AnchorPane.leftAnchor="75"/>

        <Button text="Back"
                onAction="#onBackClicked"
                prefWidth="250"
                AnchorPane.topAnchor="330"
                AnchorPane.leftAnchor="75"/>

    </children>
</AnchorPane>




