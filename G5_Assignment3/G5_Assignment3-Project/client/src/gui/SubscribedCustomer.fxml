<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="650.0" prefWidth="500.0"
            style="-fx-background-color: #1e1e2f;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.SubscribedCustomer_GUI">

    <children>
        <VBox alignment="CENTER" spacing="8"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="30">

            <Label fx:id="welcomeLabel" text="Welcome Back, Subscriber!"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />

            <Label text="Bistro Member Dashboard"
                   style="-fx-font-size: 14px; -fx-text-fill: #b0b3c6;" />
        </VBox>

        <VBox spacing="16" alignment="CENTER"
              AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="130"
              style="-fx-background-color: #26283b; -fx-background-radius: 22; -fx-padding: 35;">

            <effect>
                <DropShadow color="rgba(0,0,0,0.45)" radius="25" offsetY="8"/>
            </effect>

            <Button onAction="#onNewReservation" prefHeight="52" prefWidth="320"
                    text="New Reservation"
                    style="
                    -fx-background-color: #2f324a;
                            -fx-text-fill: #b0b3c6;
                            -fx-font-size: 13px;
                            -fx-background-radius: 14;
                            -fx-cursor: hand;
                    " />

            <Button onAction="#onManageReservations" prefHeight="52" prefWidth="320"
                    text="Manage My Reservations"
                    style="
                    -fx-background-color: #2f324a;
                            -fx-text-fill: #b0b3c6;
                            -fx-font-size: 13px;
                            -fx-background-radius: 14;
                            -fx-cursor: hand;
                    " />

            <Button onAction="#onUpdateProfile" prefHeight="52" prefWidth="320"
                    text="Update Personal Details"
                    style="
                    -fx-background-color: #2f324a;
                            -fx-text-fill: #b0b3c6;
                            -fx-font-size: 13px;
                            -fx-background-radius: 14;
                            -fx-cursor: hand;
                    " />

            <Button onAction="#onPayBill" prefHeight="52" prefWidth="320"
                    text="Pay My Bill"
                    style="
                    -fx-background-color: #2f324a;
                            -fx-text-fill: #b0b3c6;
                            -fx-font-size: 13px;
                            -fx-background-radius: 14;
                            -fx-cursor: hand;
                    " />

            <Separator prefWidth="240" opacity="0.25">
                <padding><Insets top="12" bottom="10"/></padding>
            </Separator>

            <Button text="Sign Out" onAction="#onLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-cursor: hand;" />
        </VBox>

        <Label text="Bistro Member Services"
               AnchorPane.bottomAnchor="20"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               alignment="CENTER"
               style="-fx-font-size: 11px; -fx-text-fill: #7f85a3;" />
    </children>
</AnchorPane>
