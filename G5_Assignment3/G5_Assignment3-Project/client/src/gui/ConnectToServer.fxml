<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<VBox fx:id="connectPane" alignment="CENTER" spacing="30"
      style="-fx-background-color: #1e1e2f;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.ConnectToServer_GUI"
      prefHeight="600" prefWidth="500">

    <children>
        <VBox alignment="CENTER" spacing="8">
            <Label text="BISTRO SYSTEM"
                   style="-fx-text-fill: #b0b3c6; -fx-letter-spacing: 2px;"/>

            <Label text="Client Connection"
                   style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="20" alignment="CENTER"
              style="-fx-background-color: #26283b; -fx-background-radius: 22; -fx-padding: 40;">
            <effect>
                <DropShadow color="rgba(0,0,0,0.45)" radius="25" offsetY="8"/>
            </effect>

            <VBox spacing="8">
                <Label text="Server IP Address"
                       style="-fx-text-fill: #b0b3c6; -fx-font-weight: bold;"/>
                <TextField fx:id="ipField" promptText="e.g. localhost" text="localhost"
                           style="-fx-background-color: #2f324a; -fx-text-fill: white;
                                  -fx-background-radius: 12; -fx-padding: 12;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Network Port"
                       style="-fx-text-fill: #b0b3c6; -fx-font-weight: bold;"/>
                <TextField fx:id="portField" promptText="5555" text="5555"
                           style="-fx-background-color: #2f324a; -fx-text-fill: white;
                                  -fx-background-radius: 12; -fx-padding: 12;"/>
            </VBox>

            <Region prefHeight="10"/>

            <Button fx:id="connectBtn"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#onConnectClicked"
                    text="ESTABLISH CONNECTION"
                    prefHeight="45"
                    style="-fx-background-color: #2ecc71;
                           -fx-text-fill: #1e1e2f;
                           -fx-font-weight: bold;
                           -fx-background-radius: 14;
                           -fx-cursor: hand;"/>

            <Label fx:id="errorLabel"
                   style="-fx-text-fill: #e74c3c;"
                   wrapText="true"
                   alignment="CENTER"/>
        </VBox>
    </children>
</VBox>
