<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="600.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.ViewReservations_GUI"
            style="-fx-background-color: #1e1e2f;">

    <children>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="6"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              AnchorPane.topAnchor="35">

            <Label text="Bistro Service"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

            <Label text="My Reservations"
                   style="-fx-font-size: 14px; -fx-text-fill: #b0b3c6;"/>
        </VBox>

        <!-- Main Card -->
        <VBox spacing="20" alignment="CENTER"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40"
              AnchorPane.topAnchor="140"
              style="-fx-background-color: #26283b; -fx-background-radius: 22; -fx-padding: 35;">

            <effect>
                <DropShadow color="rgba(0,0,0,0.45)"
                            radius="25"
                            offsetX="0"
                            offsetY="8"/>
            </effect>

            <!-- Table -->
            <TableView fx:id="reservationsTable" prefHeight="220"
                       style="
                           -fx-background-color: #2f324a;
                           -fx-background-radius: 12;
                           -fx-border-radius: 12;
                           -fx-border-color: #3c3f58;
                           -fx-table-cell-border-color: transparent;
                           -fx-text-fill: #ffffff;
                       ">
                <columns>
                    <TableColumn fx:id="colCode" text="Conf. Code" prefWidth="120"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="140"/>
                    <TableColumn fx:id="colTime" text="Time" prefWidth="100"/>
                    <TableColumn fx:id="colGuests" text="Guests" prefWidth="80"/>
                </columns>
            </TableView>

            <Separator opacity="0.3"/>

            <!-- Edit Area -->
            <HBox spacing="15" alignment="CENTER">
                <VBox spacing="4">
                    <Label text="Date" style="-fx-text-fill: #b0b3c6;"/>
                    <DatePicker fx:id="editDatePicker" prefWidth="140"
                                style="-fx-background-radius: 10; -fx-background-color: #2f324a; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Time" style="-fx-text-fill: #b0b3c6;"/>
                    <ComboBox fx:id="editTimeCombo" prefWidth="110"
                              style="-fx-background-radius: 10; -fx-background-color: #2f324a; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Guests" style="-fx-text-fill: #b0b3c6;"/>
                    <TextField fx:id="editGuestsField" prefWidth="80"
                               style="-fx-background-radius: 10; -fx-background-color: #2f324a; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <!-- Buttons -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="Update"
                        onAction="#onUpdateClicked"
                        prefWidth="110"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: #1e1e2f; -fx-font-weight: bold; -fx-background-radius: 12;"/>

                <Button text="Delete"
                        onAction="#onDeleteClicked"
                        prefWidth="110"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12;"/>

                <Button text="Back"
                        onAction="#onBackClicked"
                        prefWidth="110"
                        style="-fx-background-color: transparent; -fx-text-fill: #b0b3c6; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <!-- Footer -->
        <Label text="Bistro Management System v1.0"
               AnchorPane.bottomAnchor="20"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               alignment="CENTER"
               style="-fx-font-size: 10px; -fx-text-fill: #7f85a3;"/>
    </children>
</AnchorPane>

