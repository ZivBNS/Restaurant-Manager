<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.bill_manager">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Bill Manager" style="-fx-font-size:18; -fx-font-weight:bold;"/>

            <GridPane hgap="8" vgap="8">
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Amount:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="amountField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Due Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="duePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="categoryField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Add" onAction="#addBill"/>
                <Button text="Delete" onAction="#deleteBill"/>
                <Button text="Mark Paid" onAction="#markPaid"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="160"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="90"/>
                <TableColumn fx:id="dueCol" text="Due Date" prefWidth="110"/>
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="120"/>
                <TableColumn fx:id="paidCol" text="Paid" prefWidth="70"/>
            </columns>
        </TableView>
    </center>

</BorderPane>









