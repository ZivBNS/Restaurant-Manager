<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.ViewCasualCustomerOrder_GUI"
            prefWidth="400" prefHeight="500"
            style="-fx-background-color: #f7f7f7;">

    <children>

        <!-- Page Title -->
        <Label text="View Order"
               AnchorPane.topAnchor="20"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               alignment="CENTER"
               style="-fx-font-size: 26px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2c3e50;" />

        <!-- Card -->
        <VBox spacing="14"
              AnchorPane.topAnchor="70"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40"
              style="
                  -fx-background-color: white;
                  -fx-background-radius: 16;
                  -fx-padding: 30;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);
              ">

            <!-- Section Header -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="Order Details"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: 600;
                              -fx-text-fill: #2c3e50;" />
                <Separator prefWidth="200" opacity="0.6"/>
            </VBox>

            <!-- Demo Order Info -->
            <Label text="Order ID: 12345"/>
            <Label text="Guests: 4"/>
            <Label text="Date: 15/12/2025"/>
            <Label text="Time: 19:30"/>
            <Label text="Status: Confirmed"/>

            <!-- Back -->
            <Button text="Back"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;"
                    prefWidth="100"
                    onAction="#onBackClicked"/>

        </VBox>

    </children>
</AnchorPane>

