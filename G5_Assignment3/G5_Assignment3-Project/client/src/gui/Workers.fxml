<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane fx:id="managerRoot"
            minHeight="600" minWidth="900"
            style="-fx-background-color: #1e1e2f;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.Workers_GUI">

    <top>
        <VBox alignment="CENTER" spacing="6">
            <padding>
                <Insets top="35" bottom="20"/>
            </padding>
            <Label text="Employee Panel"
                   style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
            <Label text="Bistro Management Dashboard"
                   style="-fx-text-fill: #b0b3c6; -fx-font-size: 13px;"/>
                   
            <Separator maxWidth="280" opacity="0.3"/>
        </VBox>
    </top>

    <center>
        <TilePane alignment="CENTER" hgap="30" vgap="30"
                  prefColumns="3" prefTileHeight="150" prefTileWidth="250">
            <padding>
                <Insets top="20" left="40" right="40" bottom="40"/>
            </padding>

            <!-- Button Template -->
            <Button fx:id="btnManageOpeningHours"
                    text="Manage Opening Hours"
                    style="-fx-background-color: #2f324a; -fx-text-fill: #b0b3c6;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"
                           maxWidth="Infinity"
                           maxHeight="Infinity"
                           >
                <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
            </Button>

            <Button fx:id="btnManageTables" text="Manage Tables"
                    style="-fx-background-color: #2f324a; -fx-text-fill: #b0b3c6;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                           >
                <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
            </Button>

            <Button fx:id="btnManageUsers" text="Manage Users"
                    style="-fx-background-color: #2f324a; -fx-text-fill: #b0b3c6;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                           >
                <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
            </Button>

            <Button fx:id="btnReports" text="View Reports"
                    style="-fx-background-color: #3a2f1f; -fx-text-fill: #f5c27a;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                           >
                <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
            </Button>

            <Button fx:id="btnManageOrders" text="Manage Orders"
                    style="-fx-background-color: #2f324a; -fx-text-fill: #b0b3c6;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                           >
                <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
            </Button>

            <Button fx:id="btnManageWaitlist" text="Manage Waitlist"
                    style="-fx-background-color: #2f324a; -fx-text-fill: #b0b3c6;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 18; -fx-cursor: hand;"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                           >
                <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
            </Button>

        </TilePane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding><Insets left="20" bottom="20"/></padding>
            <Button fx:id="btnLogout"
                    text="⟵ Log Out"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #e74c3c;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
