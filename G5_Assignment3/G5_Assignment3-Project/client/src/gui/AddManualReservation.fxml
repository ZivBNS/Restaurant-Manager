<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" prefWidth="450.0" style="-fx-background-color: #ffffff; -fx-border-color: #dcdde1; -fx-border-width: 1;" 
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="gui.AddManualReservation_GUI">
    <padding> <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /> </padding>
    <children>
        <VBox spacing="5.0">
            <children>
                <Label text="New Manual Reservation" textFill="#2c3e50">
                    <font> <Font name="System Bold" size="22.0" /> </font>
                </Label>
                <Label text="Fill at least one contact method (Phone or Email)" textFill="#7f8c8d">
                    <font> <Font size="12.0" /> </font>
                </Label>
            </children>
        </VBox>
        <Separator />
        
        <GridPane hgap="15.0" vgap="15.0">
          <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          </columnConstraints>
          <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
          </rowConstraints>
           <children>
              <VBox GridPane.columnSpan="2">
                 <children>
                    <Label text="Subscriber ID (Optional)" />
                    <TextField fx:id="mUserID" promptText="Member ID" />
                 </children>
              </VBox>
              
              <VBox GridPane.rowIndex="1">
                 <children>
                    <Label text="Phone Number *" />
                    <TextField fx:id="mPhone" promptText="05XXXXXXXX" />
                 </children>
              </VBox>
              
              <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                 <children>
                    <Label text="Email Address *" />
                    <TextField fx:id="mEmail" promptText="example@mail.com" />
                 </children>
              </VBox>
              
              <VBox GridPane.rowIndex="2">
                 <children>
                    <Label text="Number of Diners *" />
                    <TextField fx:id="mGuests" promptText="1-10" />
                 </children>
              </VBox>
              
              <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                 <children>
                    <Label text="Date *" />
                    <DatePicker fx:id="mDatePicker" maxWidth="Infinity" editable="false" />
                 </children>
              </VBox>
              
              <VBox GridPane.columnSpan="2" GridPane.rowIndex="3">
                 <children>
                    <Label text="Arrival Time *" />
                    <ComboBox fx:id="mTimeCombo" maxWidth="Infinity" promptText="Select Slot" />
                 </children>
              </VBox>
           </children>
        </GridPane>
        
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button onAction="#onCancel" prefWidth="100.0" style="-fx-background-color: #95a5a6;" text="Discard" textFill="WHITE" />
                <Button onAction="#onSave" prefWidth="150.0" style="-fx-background-color: #27ae60;" text="Create Order" textFill="WHITE">
                    <font> <Font name="System Bold" size="14.0" /> </font>
                </Button>
            </children>
            <VBox.margin> <Insets top="10.0" /> </VBox.margin>
        </HBox>
    </children>
</VBox>