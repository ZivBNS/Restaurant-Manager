<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="900.0" 
            stylesheets="/Theme/application.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="gui.ManageOrders_GUI">
   
   <top>
      <BorderPane prefHeight="60.0" styleClass="page-header">
         <padding> <Insets left="20.0" right="20.0" /> </padding>
         <left>
            <Label text="Order Management" styleClass="header-title" BorderPane.alignment="CENTER_LEFT"/>
         </left>
         
         <right>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER_RIGHT">
               <children>
                 <Button onAction="#onManualAddClicked" text="+ New Order" styleClass="button, btn-success" />
                 <Button onAction="#onCreateBillClicked" text="Create Bill" styleClass="button, btn-success" />
                 <Button onAction="#refreshAdminData" text="Refresh" styleClass="button, btn-primary" />
               </children>
            </HBox>
         </right>
      </BorderPane>
   </top>

   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding> <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /> </padding>
         <children>
            
            <VBox styleClass="card" spacing="10.0">
               <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
               
               <Label text="Edit Selected Order" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
               <Separator opacity="0.1"/>

               <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints percentWidth="12" />
                      <ColumnConstraints percentWidth="18" />
                      <ColumnConstraints percentWidth="18" />
                      <ColumnConstraints percentWidth="17" />
                      <ColumnConstraints percentWidth="35" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="30.0" />
                      <RowConstraints minHeight="30.0" />
                      <RowConstraints minHeight="30.0" />
                      <RowConstraints minHeight="30.0" />
                    </rowConstraints>
                     <children>
                        <Label text="User ID:" styleClass="card-label" />
                        <Label text="Phone:" styleClass="card-label" GridPane.columnIndex="1" />
                        <Label text="Email:" styleClass="card-label" GridPane.columnIndex="2" />
                        <Label text="Table ID:" styleClass="card-label" GridPane.columnIndex="3" />
                        <Label text="Status:" styleClass="card-label" GridPane.columnIndex="4" />

                        <TextField fx:id="txtUserID" editable="false" GridPane.rowIndex="1" disable="true"/>
                        <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="txtEmail" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtTable" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" disable="true"/>
                        <TextField fx:id="txtStatus" editable="false" GridPane.columnIndex="4" GridPane.rowIndex="1" disable="true"/>
                        
                        <Label text="Date &amp; Time:" styleClass="card-label" GridPane.rowIndex="2" />
                        <Label text="Created At:" styleClass="card-label" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label text="Diners:" styleClass="card-label" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        
                        <HBox spacing="5.0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                            <children>
                              <DatePicker fx:id="datePicker" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                              <ComboBox fx:id="timeCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        
                        <TextField fx:id="txtCreationTime" editable="false" GridPane.columnIndex="2" GridPane.rowIndex="3" disable="true"/>
                        <TextField fx:id="txtGuests" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                        
                        <HBox alignment="BOTTOM_RIGHT" spacing="10.0" GridPane.columnIndex="4" GridPane.rowIndex="2" GridPane.rowSpan="2">
                           <children>
                              <Button text="Back" onAction="#onBackClicked" styleClass="button, btn-secondary" prefWidth="100.0" minWidth="80.0"/>
                              <Button text="Delete" onAction="#onDeleteClicked" styleClass="button, btn-danger" prefWidth="100.0" minWidth="80.0"/>
                              <Button text="Save" onAction="#onAdminSaveClicked" styleClass="button, btn-success" prefWidth="100.0" minWidth="80.0"/>
                           </children>
                        </HBox>
                     </children>
               </GridPane>
            </VBox>

            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10.0">
               <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
               
               <Label text="Active Orders List" style="-fx-font-size: 14px; -fx-text-fill: #8f9bb3; -fx-font-weight: bold;"/>
               
               <TableView fx:id="adminTable" VBox.vgrow="ALWAYS">
                   <columns>
                    <TableColumn fx:id="colCode" text="CODE" prefWidth="90"/>
                    <TableColumn fx:id="colUserID" text="USER ID" prefWidth="70"/>
                    <TableColumn fx:id="colPhone" text="PHONE" prefWidth="110"/>
                    <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="160"/>
                    <TableColumn fx:id="colDate" text="DATE" prefWidth="90"/>
                    <TableColumn fx:id="colTime" text="TIME" prefWidth="60"/>
                    <TableColumn fx:id="colGuests" text="GUESTS" prefWidth="60"/>
                    <TableColumn fx:id="colTable" text="TABLE" prefWidth="60"/>
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="90"/>
                  </columns>
                 <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>
            </VBox>

         </children>
      </VBox>
   </center>
</BorderPane>