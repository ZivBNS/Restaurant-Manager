<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1250.0" stylesheets="/Theme/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ManageOrders_GUI">

    <top>
        <VBox alignment="CENTER" spacing="10" styleClass="page-header">
            <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>
            <Label alignment="CENTER" styleClass="header-title" text="Reservation Management" />
            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button onAction="#refreshAdminData" styleClass="button" text="Refresh Table" />
                <Button onAction="#onCreateBillClicked" styleClass="button" text="Bill Manager" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="10" style="-fx-background-color: transparent;">
            
            <VBox HBox.hgrow="ALWAYS">
                <padding><Insets bottom="10" left="10" right="5" top="10" /></padding>
                <TableView fx:id="adminTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="70.0" text="Code" />
                        <TableColumn fx:id="colUserID" prefWidth="70.0" text="User ID" />
                        <TableColumn fx:id="colPhone" prefWidth="100.0" text="Phone" />
                        <TableColumn fx:id="colEmail" prefWidth="120.0" text="Email" />
                        <TableColumn fx:id="colDate" prefWidth="90.0" text="Date" />
                        <TableColumn fx:id="colTime" prefWidth="65.0" text="Time" />
                        <TableColumn fx:id="colGuests" prefWidth="60.0" text="Guests" />
                        <TableColumn fx:id="colTable" prefWidth="60.0" text="Table" />
                        <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </VBox>

            <VBox maxWidth="360.0" minWidth="360.0" prefWidth="360.0" spacing="15.0" styleClass="card">
                <HBox.margin>
                    <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
                </HBox.margin>
                <padding><Insets bottom="20" left="25" right="25" top="20" /></padding>
                
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Order Details" />
                <Separator opacity="0.2" />

                <VBox spacing="12" VBox.vgrow="ALWAYS">
                    <VBox spacing="5">
                        <Label styleClass="card-label" text="Order Confirmation Code" />
                        <TextField fx:id="txtOrderID" disable="true" prefHeight="35.0" text="New" />
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="card-label" text="Subscriber ID (Enter to search)" />
                        <TextField fx:id="txtUserID" prefHeight="35.0" promptText="Member ID" />
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-label" text="Phone Number" />
                            <TextField fx:id="txtPhone" prefHeight="35.0" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-label" text="Email Address" />
                            <TextField fx:id="txtEmail" prefHeight="35.0" />
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-label" text="Guests" />
                            <Spinner fx:id="spGuests" editable="true" maxWidth="Infinity" prefHeight="35.0" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-label" text="Table ID" />
                            <TextField fx:id="txtTable" disable="true" prefHeight="35.0" text="Auto" />
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label styleClass="card-label" text="Pick a Date" />
                        <DatePicker fx:id="datePicker" maxWidth="Infinity" prefHeight="35.0" />
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="card-label" text="Time Slot" />
                        <ComboBox fx:id="timeCombo" maxWidth="Infinity" prefHeight="35.0" />
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="card-label" text="Current Status" />
                        <ComboBox fx:id="cbStatus" maxWidth="Infinity" prefHeight="35.0" />
                    </VBox>
                </VBox>

                <Separator opacity="0.2" />

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                    </columnConstraints>
                    <children>
                        <Button maxWidth="Infinity" prefHeight="45.0" onAction="#onClearClicked" 
                                styleClass="button, btn-secondary" text="Clear Form" 
                                GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        
                        <Button fx:id="btnAdd" maxWidth="Infinity" prefHeight="45.0" onAction="#onAddClicked" 
                                styleClass="button, btn-primary" text="Create Order" 
                                GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Button fx:id="btnUpdate" disable="true" maxWidth="Infinity" prefHeight="45.0" 
                                onAction="#onUpdateClicked" styleClass="button" text="Update Selected" 
                                GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        
                        <Button fx:id="btnCancel" disable="true" maxWidth="Infinity" prefHeight="45.0" 
                                onAction="#onDeleteClicked" styleClass="button, btn-danger" text="Cancel Order" 
                                GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10">
            <padding><Insets left="20" /></padding>
            <Button onAction="#onBackClicked" styleClass="button, btn-secondary" text="Back to Menu" />
        </HBox>
    </bottom>

</BorderPane>