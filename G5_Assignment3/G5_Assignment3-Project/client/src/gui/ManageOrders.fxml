<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="800.0" prefWidth="900.0" style="-fx-background-color: #f4f4f4;" 
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="gui.ManageOrders_GUI">
   
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1300.0" 
            style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Employee Dashboard - Order Management" textFill="WHITE">
               <font> <Font name="System Bold" size="24.0" /> </font>
               <HBox.margin> <Insets left="20.0" /> </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onManualAddClicked" style="-fx-background-color: #27ae60;" text="Manual Order +" textFill="WHITE">
               <font> <Font name="System Bold" size="13.0" /> </font>
               <HBox.margin> <Insets right="10.0" /> </HBox.margin>
            </Button>
            <Button onAction="#refreshAdminData" style="-fx-background-color: #3498db;" text="Refresh" textFill="WHITE">
               <HBox.margin> <Insets right="20.0" /> </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding> <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /> </padding>
         <children>
            <TitledPane collapsible="false" text="Order Editor &amp; Details">
               <content>
                  <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints minWidth="100.0" prefWidth="150.0" />
                      <ColumnConstraints minWidth="100.0" prefWidth="150.0" />
                      <ColumnConstraints minWidth="100.0" prefWidth="200.0" />
                      <ColumnConstraints minWidth="100.0" prefWidth="200.0" />
                      <ColumnConstraints minWidth="100.0" prefWidth="150.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="30.0" />
                      <RowConstraints minHeight="30.0" />
                      <RowConstraints minHeight="30.0" />
                      <RowConstraints minHeight="30.0" />
                    </rowConstraints>
                     <children>
                        <Label text="User ID (Locked)" />
                        <TextField fx:id="txtUserID" editable="false" style="-fx-background-color: #eeeeee;" GridPane.rowIndex="1" />
                        
                        <Label text="Status (Locked)" GridPane.columnIndex="4" />
                        <TextField fx:id="txtStatus" editable="false" style="-fx-background-color: #eeeeee;" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                        
                        <Label text="Table ID (Locked)" GridPane.columnIndex="3" />
                        <TextField fx:id="txtTable" editable="false" style="-fx-background-color: #eeeeee;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="Phone" GridPane.columnIndex="1" />
                        <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Email" GridPane.columnIndex="2" />
                        <TextField fx:id="txtEmail" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        
                        <Label text="Diners" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        <TextField fx:id="txtGuests" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                        
                        <Label text="Date &amp; Time" GridPane.rowIndex="2" />
                        <HBox spacing="5.0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                           <children>
                              <DatePicker fx:id="datePicker" />
                              <ComboBox fx:id="timeCombo" prefWidth="100.0" />
                           </children>
                        </HBox>
                        
                        <Label text="Created At (System):" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <TextField fx:id="txtCreationTime" editable="false" style="-fx-background-color: #eeeeee;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        
                        <VBox alignment="BOTTOM_CENTER" spacing="5.0" GridPane.columnIndex="4" GridPane.rowIndex="2" GridPane.rowSpan="2">
                           <children>
                              <Button maxWidth="Infinity" onAction="#onAdminSaveClicked" style="-fx-background-color: #27ae60;" text="Save Changes" textFill="WHITE">
                                 <font> <Font name="System Bold" size="13.0" /> </font>
                              </Button>
                              <HBox spacing="5.0">
                                 <children>
                                    <Button maxWidth="Infinity" onAction="#onDeleteClicked" style="-fx-background-color: #e74c3c;" text="Delete" textFill="WHITE" HBox.hgrow="ALWAYS" />
                                    <Button maxWidth="Infinity" onAction="#onBackClicked" style="-fx-background-color: #95a5a6;" text="Back" textFill="WHITE" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </GridPane>
               </content>
            </TitledPane>

            <TableView fx:id="adminTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colCode" text="Conf. Code" />
                <TableColumn fx:id="colUserID" text="User ID" />
                <TableColumn fx:id="colPhone" text="Phone" />
                <TableColumn fx:id="colEmail" text="Email" />
                <TableColumn fx:id="colDate" text="Date" />
                <TableColumn fx:id="colTime" text="Time" />
                <TableColumn fx:id="colGuests" text="Guests" />
                <TableColumn fx:id="colTable" text="Table" />
                <TableColumn fx:id="colStatus" text="Status" />
              </columns>
              <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>