<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="/Theme/application.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ManageWaitlist_GUI">

    <top>
        <VBox alignment="CENTER" spacing="10" styleClass="page-header">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            <children>
                <Label styleClass="header-title" text="Waitlist Management" />
                <Label style="-fx-text-fill: white; -fx-opacity: 0.7;" text="View and monitor active waiting list entries" />
                <Separator maxWidth="400" opacity="0.3" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" styleClass="card">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>
            <children>
                

				<HBox alignment="CENTER_RIGHT" spacing="10">
				    <Button fx:id="btnCancel" onAction="#onCancelClicked" styleClass="button, btn-danger" text="Cancel Selected" />
				    <Button onAction="#onRefreshClicked" styleClass="button" text="Refresh Data" />
				</HBox>
                <TableView fx:id="waitlistTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colConfCode" prefWidth="150.0" text="Confirmation Code" />
                        <TableColumn fx:id="colGuests" prefWidth="100.0" text="Guests" />
                        <TableColumn fx:id="colCreated" prefWidth="250.0" text="Created Time" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
            <VBox.margin>
                <Insets bottom="30.0" left="50.0" right="50.0" top="10.0" />
            </VBox.margin>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0">
            <padding>
                <Insets left="40" />
            </padding>
            <children>
                <Button onAction="#onBackClicked" styleClass="button, btn-secondary" text="Back to Menu" />
            </children>
        </HBox>
    </bottom>

</BorderPane>